    {
      "id": "v03",
      "from": 155,
      "to": 356,
      "text": "انطلق التسجيل بالدورات الصيفية للعام الدراسي 2027-2028، ويّا الأستاذ حيدر الملاح،",
      "voiced": "انطلق التسجيل بالدورات الصيفية، للعام الدراسي ألفين وسبعة وعشرين، ألفين وثمانية وعشرين، ويّا الأستاذ حيدر الملّاح،",
      "emphasis": [
        "حيدر الملاح"
      ],
      "durationSource": "final",
      "silent": false,
      "audioFrom": 155,
      "audioTo": 374
    },
    {
      "id": "v04",
      "from": 380,
      "to": 517,
      "text": "بالجانب الأيسر حصراً، بمعهد المتميزين الكائن بحي الحدباء.",
      "voiced": "بالجانب الأيسر حصراً، بمعهد المتميّزين، الكائن بحي الحدباء.",
      "emphasis": [
        "الجانب الأيسر حصراً",
        "معهد المتميزين"
      ],
      "durationSource": "final",
      "silent": false,
      "audioFrom": 380,
      "audioTo": 520
    },
    {
      "id": "v05",
      "from": 537,
      "to": 682,
      "text": "ويّانا راح تحصلون على",
      "voiced": "ويّانا راح تحصلون على",
      "emphasis": [],
      "durationSource": "final",
      "silent": false,
      "audioFrom": 537,
      "audioTo": 582
    },
    {
      "id": "v06",
      "from": 701,
      "to": 838,
      "text": "شرح مفصل للمادة،",
      "voiced": "شرح مفصّل للمادة،",
      "emphasis": [
        "شرح مفصل للمادة"
      ],
      "durationSource": "final",
      "silent": false,
      "audioFrom": 701,
      "audioTo": 745
    },
    {
      "id": "v07",
      "from": 856,
      "to": 1012,
      "text": "وامتحانات يومية وأسبوعية وشاملة لكل وحدة.",
      "voiced": "وامتحانات يومية، وأسبوعية، وشاملة لكل وحدة.",
      "emphasis": [
        "امتحانات"
      ],
      "durationSource": "final",
      "silent": false,
      "audioFrom": 856,
      "audioTo": 974
    },
    {
      "id": "v08",
      "from": 1030,
      "to": 1210,
      "text": "ونظام إلكتروني دقيق يتابع حضوركم ودرجاتكم،",
      "voiced": "ونظام إلكتروني دقيق، يتابع حضوركم ودرجاتكم،",
      "emphasis": [
        "نظام إلكتروني دقيق"
      ],
      "durationSource": "final",
      "silent": false,
      "audioFrom": 1030,
      "audioTo": 1144
    },
    {
      "id": "v09",
      "from": 1228,
      "to": 1419,
      "text": "مع تواصل مباشر ومستمر ويّا أولياء الأمور.",
      "voiced": "مع تواصل مباشر ومستمر، ويّا أولياء الأمور.",
      "emphasis": [
        "تواصل مباشر"
      ],
      "durationSource": "final",
      "silent": false,
      "audioFrom": 1228,
      "audioTo": 1328
    },
    {
      "id": "v10",
      "from": 1437,
      "to": 1665,
      "text": "ومراجعة مفصلة ومتابعة مستمرة للطالب، من بداية الدورة ولحد قاعة الامتحان.",
      "voiced": "ومراجعة مفصّلة، ومتابعة مستمرة للطالب، من بداية الدورة، ولحدّ قاعة الامتحان.",
